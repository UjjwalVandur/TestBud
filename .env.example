APP_ENV=development
PORT=8080

# Neon pooled connection string. Keep sslmode=require for Neon.
DATABASE_URL=postgres://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Set false in tests or local experiments when you do not want startup migrations.
AUTO_MIGRATE=true

# Comma-separated list of allowed CORS origins for the frontend dashboard.
CORS_ORIGINS=http://localhost:3000

# Optional: AI-powered test generation via AWS Bedrock (Gemma 4)
# Leave blank to use rule-based generation only.
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=google.gemma-4-31b
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Clerk Authentication (Required for UI and dual-auth middleware)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
